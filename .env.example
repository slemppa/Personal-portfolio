# Neon connection string (offers/leads + Payload, which uses the `payload` schema)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Long random string used to sign Payload auth tokens
PAYLOAD_SECRET=
# Vercel Blob token for CMS media uploads (optional locally: files go to ./media)
BLOB_READ_WRITE_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Existing integrations (unchanged)
ANTHROPIC_API_KEY=
OFFER_MODEL=
OFFER_API_KEY=
GITHUB_TOKEN=
GITHUB_USER=
YT_HANDLE=
BREVO_API_KEY=
BREVO_LIST_ID=
RESEND_API_KEY=
RESEND_FROM=
