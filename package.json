    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/typography": "^0.5.19",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "highlight.js": "11.11.2",
    "js-yaml": "^4.2.0",
    "lucide-react": "^0.563.0",
    "next": "16.3.3",
    "payload": "3.90.2",
    "posthog-js": "^1.386.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
