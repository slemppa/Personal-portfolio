# Neon connection string (same database as the portfolio; Payload uses the `payload` schema)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Long random string used to sign Payload auth tokens
PAYLOAD_SECRET=
# Vercel Blob token for media uploads in production (optional locally)
BLOB_READ_WRITE_TOKEN=
# Vercel deploy hook of the portfolio site; called when a published post changes
PORTFOLIO_DEPLOY_HOOK_URL=
